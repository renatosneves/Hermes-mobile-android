                <item android:color="#FFFF5CA8" android:offset="0" />
                <item android:color="#FF8B5CFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Bold H at the centre -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,40 h6.5 v10.5 h11 v-10.5 h6.5 v28 h-6.5 v-11.5 h-11 v11.5 h-6.5 z" />
